# 三高知识智能问答平台 - 环境变量配置
# 复制此文件为 .env 并修改为实际值

# === 硅基流动 API 配置 ===
SIP_API_KEY=sk-your-api-key-here
SIP_BASE_URL=https://api.siliconflow.cn/v1

# === 模型配置 ===
# 主模型（推荐 32B+ 以避免 long-prompt 幻觉）
SIP_LLM_MODEL=Qwen/Qwen2.5-32B-Instruct
# Embedding 模型
SIP_EMBED_MODEL=BAAI/bge-m3

# === 重排序（Reranker）配置（可选，启用后显著提升检索精度）===
# SIP_ENABLE_RERANK=true
# SIP_RERANK_MODEL=BAAI/bge-reranker-v2-m3
